fn describe(n) {
    if n > 0 {
        return "positive"
    } else {
        return "zero or less"
    }
}

print(describe(7))
print(describe(0))

// && and || short-circuit, so the right side is only reached when it matters
fn safe_divide(a, b) {
    if b != 0 && a / b > 2 {
        return "more than double"
    }
    return "not more than double"
}

print(safe_divide(10, 3))
print(safe_divide(10, 0))
