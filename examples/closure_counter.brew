// each call to make_counter gets its own `count`, and the `tick` declared inside
// keeps that scope alive after make_counter has already returned
fn make_counter() {
    let count = 0
    fn tick() {
        count = count + 1
        return count
    }
    return tick
}

let a = make_counter()
let b = make_counter()

print(a())
print(a())
print(a())
print(b())
